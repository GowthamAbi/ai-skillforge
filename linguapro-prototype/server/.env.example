# Copy to .env for local development. Never commit real secrets.
PORT=4100
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/linguapro
# Generate a long random secret (32+ bytes). Keep only in the server host.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Exact frontend origin, no trailing slash. Separate values with commas if needed.
CLIENT_ORIGINS=http://localhost:5173
# Optional: set when deploying behind a trusted reverse proxy.
TRUST_PROXY=false
